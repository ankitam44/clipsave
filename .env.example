# Swipefile environment configuration
#
# EXPO_PUBLIC_BACKEND_URL
#   Base URL of the Swipefile serverless backend (no trailing slash).
#   The app POSTs to `${EXPO_PUBLIC_BACKEND_URL}/api/process-link`
#   with body { "url": string } and expects the contract documented
#   in README.md ("Backend contract").
#
#   Copy this file to `.env` and fill in the real deployment URL.
EXPO_PUBLIC_BACKEND_URL=https://your-backend.example.com
